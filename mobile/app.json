{
  "expo": {
    "name": "CRUISER",
    "slug": "carfollow-cruiser",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/cruiser-road-mark.png",
    "scheme": "cruiser",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070807",
    "ios": {
      "bundleIdentifier": "com.ferhanburak.cruiser",
      "supportsTablet": false
    },
    "android": {
      "package": "com.ferhanburak.cruiser",
      "adaptiveIcon": {
        "backgroundColor": "#070807",
        "foregroundImage": "./assets/images/cruiser-road-mark.png",
        "monochromeImage": "./assets/images/cruiser-road-mark.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/cruiser-road-mark.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070807",
          "image": "./assets/images/cruiser-road-mark.png",
          "imageWidth": 150,
          "dark": {
            "backgroundColor": "#070807",
            "image": "./assets/images/cruiser-road-mark.png"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CRUISER, sürüş hızını, mesafeyi ve haritadaki konumunu hesaplamak için konumuna erişir.",
          "locationAlwaysAndWhenInUsePermission": "CRUISER, aktif sürüş oturumunu ekran kapalıyken de sürdürebilmek için konumuna erişir.",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CRUISER, profilinde ve topluluk gönderilerinde paylaşacağın görselleri seçebilmek için fotoğraflarına erişir.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#a3e635",
          "defaultChannel": "cruiser-alerts"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "78d54a5d-23e5-4cea-9c23-498e3a548cc3"
      }
    },
    "owner": "ferhanburak"
  }
}
